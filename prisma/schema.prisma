generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PASSENGER
  DRIVER
  ADMIN
}

enum RideStatus {
  REQUESTED
  SEARCHING_DRIVER
  DRIVER_ACCEPTED
  DRIVER_ARRIVING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LicenseCategory {
  A
  B
  AB
  C
  D
  E
}

enum VehicleType {
  CAR
  MOTO
}

model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String
  passwordHash         String
  role                 Role
  cpfCnpj              String?
  phone                String?
  profilePhotoUrl      String?
  profilePhotoPublicId String?
  createdAt            DateTime  @default(now())
  deletedAt            DateTime?

  driver              Driver?
  passengerRides      Ride[]               @relation("PassengerRides")
  messages            Message[]            @relation("MessageSender")
  passwordResetTokens PasswordResetToken[]
  supportTickets SupportTicket[]
  supportMessages SupportMessage[] @relation("SupportUserMessages")

  @@unique([email, role])
}

model Driver {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id])
  online      Boolean      @default(false)
  latitude    Float?
  longitude   Float?
  rating      Float        @default(5)
  vehicleType VehicleType?
  rides       Ride[]       @relation("DriverRides")
  updatedAt   DateTime     @updatedAt

  asaasAccountId String?
  documents      DriverDocument[]
  vehicles       DriverVehicle[]
}

model Ride {
  id          String  @id @default(cuid())
  passengerId String
  driverId    String?

  passenger User    @relation("PassengerRides", fields: [passengerId], references: [id])
  driver    Driver? @relation("DriverRides", fields: [driverId], references: [id])

  originLat      Float
  originLng      Float
  destinationLat Float
  destinationLng Float

  vehicleType   VehicleType
  estimatedFare Float
  commission    Float
  driverPayout  Float

  status    RideStatus @default(REQUESTED)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  paymentStatus      String     @default("NOT_PAID")
  paymentMethod      String?
  paymentConfirmedAt DateTime?
  asaasPaymentId     String?
  asaasCustomerId    String?
  messages           Message[]
  stops              RideStop[]

  @@index([status, vehicleType, driverId])
  @@index([passengerId, createdAt])
}

model Message {
  id        String   @id @default(cuid())
  rideId    String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  ride   Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  sender User @relation("MessageSender", fields: [senderId], references: [id])

  @@index([rideId, createdAt])
  @@index([senderId, createdAt])
}

model RideStop {
  id        String   @id @default(cuid())
  rideId    String
  address   String?
  latitude  Float
  longitude Float
  position  Int
  createdAt DateTime @default(now())

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@unique([rideId, position])
  @@index([rideId, position])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

enum DriverDocumentType {
  CNH
  CRIMINAL_RECORD
}

model DriverDocument {
  id               String             @id @default(cuid())
  driverId         String
  type             DriverDocumentType
  licenseNumber    String?
  licenseCategory  LicenseCategory?
  licenseExpiresAt DateTime?
  ear              Boolean            @default(false)
  frontImageUrl    String?
  frontImageFormat String?
  backImageUrl     String?
  backImageFormat  String?
  documentUrl      String?
  documentFormat   String?
  issuedAt         DateTime?
  status           DocumentStatus     @default(PENDING)
  rejectionReason  String?
  reviewedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, type])
  @@index([status])
}

model DriverVehicle {
  id               String         @id @default(cuid())
  driverId         String
  vehicleType      VehicleType
  make             String
  model            String
  year             Int
  color            String
  plate            String         @unique
  crlvUrl          String?
  crlvFormat       String?
  photoFrontUrl    String?
  photoFrontFormat String?
  photoSideUrl     String?
  photoSideFormat  String?
  status           DocumentStatus @default(PENDING)
  rejectionReason  String?
  reviewedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, vehicleType])
  @@index([status])
}

enum AdminRole {
  OWNER
  SUPERVISOR
  SUPPORT
  ANALYST
}

model AdminAccount {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(SUPPORT)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs AdminAuditLog[]
  assignedSupportTickets SupportTicket[] @relation("SupportAssignedAdmin")
  supportMessages SupportMessage[] @relation("SupportAdminMessages")
}

model AdminActivationToken {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  role      AdminRole
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actorEmail   String
  action       String
  entityType   String
  entityId     String?
  previousData Json?
  newData      Json?
  reason       String?
  createdAt    DateTime @default(now())

  actor AdminAccount? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum SupportMessageSenderType {
  USER
  ADMIN
}

model SupportTicket {
  id              String              @id @default(cuid())
  userId          String
  assignedAdminId String?
  subject         String
  category        String?
  status          SupportTicketStatus @default(OPEN)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  closedAt        DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignedAdmin AdminAccount? @relation("SupportAssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages     SupportMessage[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
  @@index([assignedAdminId, status])
}

model SupportMessage {
  id           String                   @id @default(cuid())
  ticketId     String
  senderType   SupportMessageSenderType
  senderUserId String?
  senderAdminId String?
  senderName   String
  content      String                   @db.Text
  createdAt    DateTime                 @default(now())

  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderUser User?         @relation("SupportUserMessages", fields: [senderUserId], references: [id], onDelete: SetNull)
  senderAdmin AdminAccount? @relation("SupportAdminMessages", fields: [senderAdminId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([senderUserId, createdAt])
  @@index([senderAdminId, createdAt])
}
