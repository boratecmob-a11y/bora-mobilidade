generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PASSENGER
  DRIVER
  ADMIN
}

enum RideStatus {
  REQUESTED
  SEARCHING_DRIVER
  DRIVER_ACCEPTED
  DRIVER_ARRIVING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LicenseCategory {
  A
  B
  AB
  C
  D
  E
}

enum VehicleType {
  CAR
  MOTO
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String
  passwordHash    String
  role            Role
  cpfCnpj         String?
  phone           String?
  profilePhotoUrl      String?
  profilePhotoPublicId String?
  createdAt       DateTime @default(now())
  deletedAt       DateTime?

  driver          Driver?
  passengerRides  Ride[]   @relation("PassengerRides")
  messages        Message[] @relation("MessageSender")
  passwordResetTokens PasswordResetToken[]

  @@unique([email, role])
}

model Driver {
  id             String      @id @default(cuid())
  userId         String      @unique
  user            User        @relation(fields: [userId], references: [id])
  online         Boolean     @default(false)
  latitude       Float?
  longitude      Float?
  rating         Float       @default(5)
  vehicleType    VehicleType?
  rides          Ride[]      @relation("DriverRides")
  updatedAt      DateTime    @updatedAt

  asaasAccountId String?
  documents       DriverDocument[]
  vehicles        DriverVehicle[]
}

model Ride {
  id               String      @id @default(cuid())
  passengerId      String
  driverId         String?

  passenger        User        @relation("PassengerRides", fields: [passengerId], references: [id])
  driver           Driver?     @relation("DriverRides", fields: [driverId], references: [id])

  originLat        Float
  originLng        Float
  destinationLat   Float
  destinationLng   Float

  vehicleType      VehicleType
  estimatedFare    Float
  commission       Float
  driverPayout     Float

  status           RideStatus  @default(REQUESTED)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  paymentStatus    String      @default("NOT_PAID")
  paymentMethod    String?
  paymentConfirmedAt DateTime?
  asaasPaymentId   String?
  asaasCustomerId  String?

  @@index([status, vehicleType, driverId])
  @@index([passengerId, createdAt])
  messages         Message[]
  stops            RideStop[]
}

model Message {
  id        String   @id @default(cuid())
  rideId    String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  ride   Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  sender User @relation("MessageSender", fields: [senderId], references: [id])

  @@index([rideId, createdAt])
  @@index([senderId, createdAt])
}

model RideStop {
  id        String   @id @default(cuid())
  rideId    String
  address   String?
  latitude  Float
  longitude Float
  position  Int
  createdAt DateTime @default(now())

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@unique([rideId, position])
  @@index([rideId, position])
}


model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

enum DriverDocumentType {
  CNH
  CRIMINAL_RECORD
}

model DriverDocument {
  id               String             @id @default(cuid())
  driverId         String
  type             DriverDocumentType
  licenseNumber    String?
  licenseCategory  LicenseCategory?
  licenseExpiresAt DateTime?
  ear              Boolean            @default(false)
  frontImageUrl    String?
  frontImageFormat String?
  backImageUrl     String?
  backImageFormat  String?
  documentUrl      String?
  documentFormat   String?
  issuedAt         DateTime?
  status           DocumentStatus     @default(PENDING)
  rejectionReason  String?
  reviewedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, type])
  @@index([status])
}

model DriverVehicle {
  id              String         @id @default(cuid())
  driverId        String
  vehicleType     VehicleType
  make            String
  model           String
  year            Int
  color           String
  plate           String         @unique
  crlvUrl         String?
  crlvFormat      String?
  photoFrontUrl   String?
  photoFrontFormat String?
  photoSideUrl    String?
  photoSideFormat String?
  status          DocumentStatus @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, vehicleType])
  @@index([status])
}
